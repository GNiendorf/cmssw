<!-- Lanes may only APPEND <use> lines. -->
<!-- host-only plugins (comparators, converters) -->
<library file="*.cc" name="RecoTrackerMkFitAlpakaPlugins">
  <use name="DataFormats/BeamSpot"/>
  <use name="DataFormats/TrackCandidate"/>
  <use name="DataFormats/TrackReco"/>
  <use name="DataFormats/TrackerRecHit2D"/>
  <use name="DataFormats/TrajectorySeed"/>
  <use name="FWCore/Framework"/>
  <use name="FWCore/MessageLogger"/>
  <use name="FWCore/ParameterSet"/>
  <use name="FWCore/ServiceRegistry"/>
  <use name="FWCore/Utilities"/>
  <use name="Geometry/TrackerGeometryBuilder"/>
  <use name="RecoTracker/MkFit"/>
  <use name="RecoTracker/MkFitCMS"/>
  <use name="RecoTracker/MkFitCore"/>
  <use name="RecoTracker/MkFitAlpaka"/>
  <use name="RecoTracker/Record"/>
  <use name="CommonTools/UtilAlgos"/>
  <use name="root"/>
  <use name="TrackingTools/PatternTools"/>
  <use name="TrackingTools/TrajectoryState"/>
  <!-- otdev (round 8): on-demand OT rechits in MkFitAlpakaOutputTrackConverter -->
  <use name="RecoLocalTracker/Phase2TrackerRecHits"/>
  <use name="RecoLocalTracker/Records"/>
  <use name="Geometry/Records"/>
  <flags EDM_PLUGIN="1"/>
</library>

<!-- alpaka-based portable plugins (producers, ES producers) -->
<library file="alpaka/*.cc" name="RecoTrackerMkFitAlpakaPluginsPortable">
  <use name="alpaka"/>
  <use name="DataFormats/TrajectorySeed"/>
  <use name="DataFormats/TrackReco"/>
  <use name="FWCore/Framework"/>
  <use name="FWCore/ParameterSet"/>
  <use name="FWCore/Utilities"/>
  <use name="HeterogeneousCore/AlpakaCore"/>
  <use name="HeterogeneousCore/AlpakaInterface"/>
  <use name="RecoTracker/MkFit"/>
  <use name="RecoTracker/MkFitCMS"/>
  <use name="RecoTracker/MkFitCore"/>
  <use name="RecoTracker/MkFitAlpaka"/>
  <use name="RecoTracker/Record"/>
  <!-- otdev (round 8): device OT rechits (stock Phase2StripCPE for the per-IOV table) -->
  <use name="RecoLocalTracker/Phase2TrackerRecHits"/>
  <use name="DataFormats/Phase2TrackerCluster"/>
  <use name="DataFormats/BeamSpot"/>
  <use name="DataFormats/SiPixelDetId"/>
  <use name="DataFormats/SiStripDetId"/>
  <use name="DataFormats/TrackingRecHitSoA"/>
  <flags ALPAKA_BACKENDS="1"/>
  <flags EDM_PLUGIN="1"/>
  <!-- register CI (review M5): spill warnings only; gate = runtests testMkFitAlpakaKernelRegisters -->
  <flags CUDA_FLAGS="-Xptxas=-warn-spills"/>
</library>
<use name="DataFormats/SiPixelCluster"/>
<use name="DataFormats/TrackingRecHitSoA"/>
<use name="Geometry/CommonTopologies"/>
<use name="Geometry/Records"/>
<use name="FWCore/MessageLogger"/>
<use name="CondFormats/DataRecord"/>
<use name="CondFormats/SiPixelObjects"/>
<use name="DataFormats/TrackerCommon"/>
<use name="Geometry/TrackerGeometryBuilder"/>
<use name="RecoLocalTracker/SiPixelRecHits"/>
<use name="RecoLocalTracker/Records"/>
<use name="tbb"/>
<use name="SimDataFormats/Associations"/>
<use name="SimDataFormats/TrackingAnalysis"/>
<use name="SimTracker/Common"/>
<use name="CondFormats/SiPixelTransient"/>
<use name="MagneticField/Engine"/>
<use name="MagneticField/Records"/>
<use name="RecoLocalTracker/ClusterParameterEstimator"/>
<use name="DataFormats/TrajectoryState"/>
<use name="DataFormats/SiPixelDigiSoA"/>
<use name="DataFormats/SiPixelClusterSoA"/>
<!-- lstin: RecoTracker/LSTCore headers only (header-only SoA types); linking its CUDA library into this plugin broke kernel launches (cudaErrorInvalidResourceHandle) -->
<use name="DataFormats/TrackSoA"/>
<!-- outconv (round 7): MkFitAlpakaOutputTrackConverter -->
<use name="DataFormats/TrackingRecHit"/>
<use name="RecoTracker/MeasurementDet"/>
<use name="TrackingTools/DetLayers"/>
<use name="TrackingTools/GeomPropagators"/>
<use name="TrackingTools/KalmanUpdators"/>
<use name="TrackingTools/MeasurementDet"/>
<use name="TrackingTools/PatternTools"/>
<use name="TrackingTools/Records"/>
<use name="TrackingTools/TrajectoryState"/>
<!-- hpsel: TrackTorchClassifier feature/score SoA headers only (no link to the FinalTrackSelectors device libraries) -->
<use name="RecoTracker/FinalTrackSelectors" source_only="1"/>
<use name="DataFormats/Portable"/>
<use name="DataFormats/BeamSpot"/>
<!-- stagec (round 8): MkFitAlpakaHpClassifier folds model.pt with libtorch (host, CPU) at construction -->
<use name="pytorch"/>
<use name="DataFormats/SoATemplate"/>
<!-- stagec (round 8): MkFitAlpakaNavStudy (GeometricSearchTracker), MkFitAlpakaPcaToBeamLine.h (vdt, as stock) -->
<use name="RecoTracker/TkDetLayers"/>
<use name="vdt_headers"/>
<use name="DataFormats/GeometrySurface"/>
