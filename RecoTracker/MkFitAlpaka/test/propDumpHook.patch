+++ b/RecoTracker/MkFitCore/src/PropDumpHook.h	2026-10-03 11:19:02.722811285 -0400
@@ -0,0 +1,48 @@
+#ifndef RecoTracker_MkFitCore_src_PropDumpHook_h
+#define RecoTracker_MkFitCore_src_PropDumpHook_h
+
+// MkFitAlpaka prop lane, PRIVATE instrumentation of a local MkFitCore copy (never for production):
+// with MKFIT_PROP_DUMP=<file> set, the stock propagation / Kalman entry points record their inputs and outputs
+// in the format of RecoTracker/MkFitAlpaka/test/propTestIO.h; the file is written at program exit.
+
+#include "Matrix.h"
+
+namespace mkfit {
+  class PropagationFlags;
+
+  namespace propdump {
+    bool enabled();
+    // depth guard: calls made from inside an instrumented wrapper are not recorded separately
+    struct Guard {
+      Guard();
+      ~Guard();
+    };
+    bool inWrapper();
+    // call census of the stock entry points (printed to stderr at exit when enabled)
+    void countCall(const char* name, int N_proc);
+
+    void dump(int op,
+              const PropagationFlags* pf,
+              int propToHit,
+              int N_proc,
+              const MPlexLS& inErr,
+              const MPlexLV& inPar,
+              const MPlexQI& inChg,
+              const MPlexQF* msRad,
+              const MPlexQF* msZ,
+              const MPlexHV* plPnt,
+              const MPlexHV* plNrm,
+              const MPlexHV* plDir,
+              const MPlexHS* msErr,
+              const MPlexHV* msPar,
+              const MPlexLS* outErr,
+              const MPlexLV& outPar,
+              const MPlexQF* chi2,
+              const MPlexQI* fail,
+              const MPlexQI* chgOut,
+              const MPlexQI* noMatEff,
+              const MPlexQI* skipIfGeZero);  // doCPE: slots with CPE correction are skipped
+  }  // namespace propdump
+}  // namespace mkfit
+
+#endif
