diff -ruN a/RecoTracker/MkFitCore/src/PropDumpHook.cc b/RecoTracker/MkFitCore/src/PropDumpHook.cc
--- a/RecoTracker/MkFitCore/src/PropDumpHook.cc	1969-12-31 19:00:00.000000000 -0500
+++ b/RecoTracker/MkFitCore/src/PropDumpHook.cc	2026-10-03 11:19:41.580882526 -0400
@@ -0,0 +1,149 @@
+#include "PropDumpHook.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <string>
+#include <tuple>
+
+#include "RecoTracker/MkFitCore/interface/PropagationConfig.h"
+#include "RecoTracker/MkFitCore/interface/TrackerInfo.h"
+// angle brackets: test-only cross-package include (scram's private-header check greps quoted includes)
+#include <RecoTracker/MkFitAlpaka/test/propTestIO.h>
+
+namespace mkfit {
+  namespace propdump {
+    namespace {
+      using namespace ::mkfitdev::proptest;
+      constexpr size_t kMaxPerBlock = 150000;
+
+      struct Store {
+        std::mutex mtx;
+        std::string fn;
+        bool on = false;
+        bool haveMat = false;
+        MaterialBlock mb;
+        std::map<std::tuple<int, int, int>, OpBlock> blocks;
+        std::map<std::string, std::pair<long, long>> census;
+        Store() {
+          const char* e = std::getenv("MKFIT_PROP_DUMP");
+          if (e && *e) {
+            fn = e;
+            on = true;
+          }
+        }
+        ~Store() {
+          if (!on)
+            return;
+          std::vector<OpBlock> v;
+          for (auto& kv : blocks)
+            v.push_back(std::move(kv.second));
+          writeFile(fn, mb, v);
+          for (auto const& kv : census)
+            std::fprintf(stderr, "PROPDUMP census: %-40s calls %10ld  slots %12ld\n", kv.first.c_str(), kv.second.first, kv.second.second);
+        }
+      };
+      Store& store() {
+        static Store s;
+        return s;
+      }
+      thread_local int t_depth = 0;
+    }  // namespace
+
+    bool enabled() { return store().on; }
+    Guard::Guard() { ++t_depth; }
+    Guard::~Guard() { --t_depth; }
+    bool inWrapper() { return t_depth > 0; }
+    void countCall(const char* name, int N_proc) {
+      Store& s = store();
+      if (!s.on)
+        return;
+      std::lock_guard<std::mutex> lk(s.mtx);
+      auto& e = s.census[std::string(name) + (t_depth > 0 ? " (in wrapper)" : "")];
+      e.first += 1;
+      e.second += N_proc;
+    }
+
+    void dump(int op,
+              const PropagationFlags* pf,
+              int propToHit,
+              int N_proc,
+              const MPlexLS& inErr,
+              const MPlexLV& inPar,
+              const MPlexQI& inChg,
+              const MPlexQF* msRad,
+              const MPlexQF* msZ,
+              const MPlexHV* plPnt,
+              const MPlexHV* plNrm,
+              const MPlexHV* plDir,
+              const MPlexHS* msErr,
+              const MPlexHV* msPar,
+              const MPlexLS* outErr,
+              const MPlexLV& outPar,
+              const MPlexQF* chi2,
+              const MPlexQI* fail,
+              const MPlexQI* chgOut,
+              const MPlexQI* noMatEff,
+              const MPlexQI* skipIfGeZero) {
+      Store& s = store();
+      if (!s.on)
+        return;
+      const int pfl = pf ? ((pf->use_param_b_field ? 1 : 0) | (pf->apply_material ? 2 : 0) |
+                            (pf->copy_input_state_on_fail ? 4 : 0))
+                         : 0;
+      std::lock_guard<std::mutex> lk(s.mtx);
+      if (!s.haveMat && pf && pf->tracker_info) {
+        const TrackerInfo& ti = *pf->tracker_info;
+        s.mb.nBinsZ = ti.mat_nbins_z();
+        s.mb.nBinsR = ti.mat_nbins_r();
+        s.mb.rngZ = ti.mat_range_z();
+        s.mb.rngR = ti.mat_range_r();
+        s.mb.bbxi.resize(s.mb.nBinsZ * s.mb.nBinsR);
+        s.mb.radl.resize(s.mb.nBinsZ * s.mb.nBinsR);
+        for (int bz = 0; bz < s.mb.nBinsZ; ++bz)
+          for (int br = 0; br < s.mb.nBinsR; ++br) {
+            s.mb.bbxi[bz * s.mb.nBinsR + br] = ti.material_bbxi(bz, br);
+            s.mb.radl[bz * s.mb.nBinsR + br] = ti.material_radl(bz, br);
+          }
+        s.haveMat = true;
+      }
+      OpBlock& b = s.blocks[std::make_tuple(op, pfl, propToHit)];
+      b.op = op;
+      b.pflags = pfl;
+      b.propToHit = propToHit;
+      for (int n = 0; n < N_proc; ++n) {
+        if (b.recs.size() >= kMaxPerBlock)
+          return;
+        if (skipIfGeZero && skipIfGeZero->constAt(n, 0, 0) >= 0)
+          continue;
+        Rec r{};
+        for (int i = 0; i < 6; ++i) {
+          r.inPar[i] = inPar.constAt(n, i, 0);
+          r.outPar[i] = outPar.constAt(n, i, 0);
+          for (int j = 0; j <= i; ++j) {
+            r.inErr[symIdx(i, j)] = inErr.constAt(n, i, j);
+            if (outErr)
+              r.outErr[symIdx(i, j)] = outErr->constAt(n, i, j);
+          }
+        }
+        r.chg = inChg.constAt(n, 0, 0);
+        r.msRad = msRad ? msRad->constAt(n, 0, 0) : 0.f;
+        r.msZ = msZ ? msZ->constAt(n, 0, 0) : 0.f;
+        for (int i = 0; i < 3; ++i) {
+          r.plPnt[i] = plPnt ? plPnt->constAt(n, i, 0) : 0.f;
+          r.plNrm[i] = plNrm ? plNrm->constAt(n, i, 0) : 0.f;
+          r.plDir[i] = plDir ? plDir->constAt(n, i, 0) : 0.f;
+          r.msPar[i] = msPar ? msPar->constAt(n, i, 0) : 0.f;
+          for (int j = 0; j <= i; ++j)
+            r.msErr[i * (i + 1) / 2 + j] = msErr ? msErr->constAt(n, i, j) : 0.f;
+        }
+        r.noMatEff = noMatEff ? noMatEff->constAt(n, 0, 0) : 0;
+        r.chi2 = chi2 ? chi2->constAt(n, 0, 0) : 0.f;
+        r.fail = fail ? fail->constAt(n, 0, 0) : 0;
+        r.chgOut = chgOut ? chgOut->constAt(n, 0, 0) : r.chg;
+        b.recs.push_back(r);
+      }
+    }
+  }  // namespace propdump
+}  // namespace mkfit
diff -ruN a/RecoTracker/MkFitCore/src/PropDumpHook.h b/RecoTracker/MkFitCore/src/PropDumpHook.h
