+// MkFitAlpaka lane fit (private copy only): MKFIT_FIT_CPE_DUMP=<file> appends one record per CPE call:
+// header {uint64 event; int32 hitIdx; uint32 rawId; float ltp[6]; float out[5]; uint16 nPix; uint16 minRow;
+// uint16 minCol; uint16 pad; 4 bytes tail padding: 72 bytes} then nPix x {uint16 row; uint16 col; uint16 adc; uint16 pad}.
+namespace {
+  struct CpeDumpRec {
+    uint64_t event;
+    int32_t hitIdx;
+    uint32_t rawId;
+    float ltp[6];
+    float out[5];
+    uint16_t nPix, minRow, minCol, pad;
+  };
+  std::mutex g_cpeDumpMutex;
+  FILE* cpeDumpFile() {
+    static FILE* f = [] {
+      const char* fn = std::getenv("MKFIT_FIT_CPE_DUMP");
+      return fn ? std::fopen(fn, "wb") : nullptr;
+    }();
+    return f;
+  }
+
+  // MkFitAlpaka lane fit (private copy only): isolated floor of the final fit (review H2). fitDumpMode "write"
+  // stores per event the input tracks (before candCutSel) and the output tracks; "readInput" replaces the input
+  // tracks by the stored ones (same fit inputs in a job with other mkFit libraries); "readOutput" skips the fit and
+  // emits the stored output tracks (the reference of the other job). Record: uint64 event, uint32 nIn, uint32 nOut,
+  // then per track: TrackBase bytes, int32 nTot, nTot x HitOnTrack.
+  std::mutex g_fitDumpMutex;
+  void writeTracks(FILE* f, const mkfit::TrackVec& v) {
+    for (auto const& t : v) {
+      std::fwrite(static_cast<const mkfit::TrackBase*>(&t), sizeof(mkfit::TrackBase), 1, f);
+      const int32_t n = t.nTotalHits();
+      std::fwrite(&n, 4, 1, f);
+      std::fwrite(t.getHitsOnTrackArray(), sizeof(mkfit::HitOnTrack), n, f);
+    }
+  }
+  bool readTracks(FILE* f, uint32_t nTrk, mkfit::TrackVec& v) {
+    v.clear();
+    v.reserve(nTrk);
+    std::vector<mkfit::HitOnTrack> hots;
+    for (uint32_t i = 0; i < nTrk; ++i) {
+      mkfit::TrackBase b;
+      int32_t n;
+      if (std::fread(&b, sizeof(b), 1, f) != 1 || std::fread(&n, 4, 1, f) != 1)
+        return false;
+      hots.resize(n);
+      if (std::fread(hots.data(), sizeof(mkfit::HitOnTrack), n, f) != size_t(n))
+        return false;
+      mkfit::Track t(b.state(), b.chi2(), b.label(), n, hots.data());
+      std::memcpy(static_cast<void*>(static_cast<mkfit::TrackBase*>(&t)), &b, sizeof(b));
+      v.push_back(t);
+    }
+    return true;
+  }
+}  // namespace
 
