+// A04: the EFFECTIVE |dTanLambda| prefilter half-width for a target. With
+// params.prefRelTanL == 0 (the default) this is exactly params.prefDTanL, so every
+// pre-A04 command line is bit-exact. Otherwise the window scales with the target's own
+// |tanLambda| -- a fractional tolerance rather than an absolute one, which is what a
+// resolution-driven window wants in the endcap (tanLambda ~ sinh(eta)).
+inline float effDTanLWindow(const AttachParams& params, float targetTanL) {
+  const float rel = params.prefRelTanL * std::fabs(targetTanL);
+  return (rel > params.prefDTanL) ? rel : params.prefDTanL;
+}
