+    if (b.pls < 0 || b.pls >= static_cast<int>(plsTaken.size()) || plsTaken[b.pls])
+      continue;
+    tgtPls[b.pos] = b.pls;
+    tgtLogit[b.pos] = b.logit;
+    plsTaken[b.pls] = 1;
