+  // The packed weld order key. MOVED HERE from ChainWeld.h (which includes this file) by M2: the
+  // per-node top-C cap below selects edges by this key and the weld takes its argmax by this key, and
+  // the whole exactness argument for the cap is that those are the SAME order. One definition only.
+  //
+  //   high word = the standard monotone float -> uint32 map, so a larger float is a larger word;
+  //   low  word = ChainEdgesSoA::tie, the stable XOR of the two endpoints' stableId, larger wins.
+  // Key 0 is the weld's "no edge" sentinel and the cap's "empty slot" sentinel; it is reachable only
+  // by the single negative NaN pattern 0xffffffff paired with tie == 0, which is the same assumption
+  // K6a already makes.
+  ALPAKA_FN_ACC ALPAKA_FN_INLINE uint32_t chainOrderFloat(float x) {
+    uint32_t const b = std::bit_cast<uint32_t>(x);
+    return (b >> 31) ? (b ^ 0xffffffffu) : (b ^ 0x80000000u);
+  }
+
+  // Its exact inverse: a value that went through an atomicMax on the order key comes back unchanged.
+  // (Sign 0: k = b ^ 0x80000000 has its top bit set, so the mask recovers b. Sign 1: k = ~b has its
+  // top bit clear, so ~k recovers b. Bit for bit, both ways.)
+  ALPAKA_FN_ACC ALPAKA_FN_INLINE float chainUnorderFloat(uint32_t k) {
+    uint32_t const b = (k & 0x80000000u) ? (k & 0x7fffffffu) : ~k;
+    return std::bit_cast<float>(b);
+  }
