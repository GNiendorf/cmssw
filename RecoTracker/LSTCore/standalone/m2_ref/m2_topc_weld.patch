+  // ==========================================================================================
+  // K4. THE PER-NODE TOP-C CAP (M2, jet speed/memory round).
+  //
+  // WHAT IT IS. The weld (K6a/K6b) gives every node ONE out-slot and ONE in-slot and fills them by
+  // mutual-best matching on the packed key (logOdds, tie). A node can therefore never consume more
+  // than a few of its incident edges, but on a collimated sample it is HANDED millions of them: the
+  // shared-MD junction degree reaches 2303 on the jet sample against 2.08 at PU200, and E1 =
+  // sum_key degIn*degOut hits 3.8e8 edges in one event, 8.4 GB of ChainEdges rows, past both the
+  // 1 GiB device-allocator bin and the 4 GiB alpaka Idx byte extent. 0.018% of those rows are ever
+  // welded.
+  //
+  // So: keep, per node, only its C highest-keyed ELIGIBLE out-edges and its C highest-keyed eligible
+  // in-edges, and weld over the UNION of those two families. The edge array is then bounded by
+  // 2*C*nNodes rows -- an EXACT, sample-independent bound -- instead of by sum_key degIn*degOut.
+  //
+  // WHY THE UNION AND NOT ONE SIDE. An edge that is its head's best in-edge but not its tail's best
+  // out-edge still BLOCKS: K6a sets bestIn[head] to it, K6b finds no mutual pair, and the head welds
+  // nothing that sweep. Delete it and the head welds a lower edge instead. Both sides are needed.
+  //
+  // WHY IT IS ELIGIBILITY-FILTERED. K6a skips `logOdds < weldBar` rows outright, so an ineligible
+  // edge can never be an argmax and never needs a slot. Ranking only the eligible edges makes the
+  // slots ~3-5x deeper in the quantity that matters (~20% of E1 / ~53% of E2 are eligible, see
+  // ChainConfig.h:20-31) and lets the emitted rows carry a permanently-open bar.
+  //
+  // EXACTNESS, stated as the falsifiable claim it is. Let R be the largest rank, over every node,
+  // direction and sweep, of that sweep's argmax within the node's own descending list of ELIGIBLE
+  // edges on that side. Then C >= R gives a BIT-IDENTICAL welded edge set, by induction on the sweep:
+  // sweep 1's argmax is always rank 1 hence kept; if sweeps 1..s-1 matched then the weld slots match,
+  // so sweep s ranges over the same eligible/free edge set, its argmax has rank <= R <= C and is
+  // therefore in the kept set, and no spurious edge can outrank it because the kept set is a SUBSET.
+  // R is NOT bounded by kChainWeldSweeps: the rank a node reaches in sweep s is
+  // 1 + #{higher-keyed eligible out-edges whose head was welded earlier}, which the sweep count does
+  // not bound. R is measured, not argued -- LST_CHAIN_RANK_CENSUS in LSTEvent.dev.cc reports it per
+  // sweep -- and the shipped C is chosen from that measurement plus a bit-identity gate.
+  //
+  // THE FIVE PASSES. Tiles of the row space are enumerated (K2) and scored (K5) into one small
+  // reusable buffer, so peak memory is tile + slots + the final compacted array:
+  //   K4a Insert  per tile: cascading atomicMax of the eligible rows' keys into the two slot lists
+  //   K4b Match   per tile, second time round (K2 only, NO MLP): give each surviving key its
+  //               endpoint and family, by finding its tie word in the endpoint's slot list
+  //   K4c Sort    order each list descending, so the emitted row order is a function of the KEPT SET
+  //               and not of the atomic interleaving
+  //   K4d Count   per-node survivor count, with the out-list/in-list duplicate removed
+  //   K4e Prefix  exclusive prefix -> each node's row base and the exact total
+  //   K4f Emit    write the compacted ChainEdges rows
+  //
+  // Slot addressing throughout: out-slot j of node n is `n*C + j`, in-slot j is `C*nNodes + n*C + j`.
+
+  // Concurrent top-C insertion by cascading atomicMax, and the reason no lock or 128-bit atomic is
+  // needed anywhere.
+  //
+  // At slot j the caller atomically installs max(slot[j], x) and carries min(slot[j], x) down to
+  // j+1. CORRECTNESS UNDER ANY INTERLEAVING: the multiset {slots} u {values still being carried} is
+  // invariant except when a carried value falls off the end at j == C, and a value that fell off was,
+  // at each of the C slots it passed, <= that slot's value AFTER the exchange. Slot values only ever
+  // increase, so a dropped value is <= every FINAL slot value. Mass conservation plus that ordering
+  // means the final slots hold exactly the C largest inserted keys -- in unspecified positions, which
+  // is why K4c sorts before anything reads them positionally.
+  template <typename TAcc>
+  ALPAKA_FN_ACC ALPAKA_FN_INLINE void chainTopCInsertKey(TAcc const& acc,
+                                                        uint64_t* slots,
+                                                        uint32_t topC,
+                                                        uint64_t key) {
+    uint64_t x = key;
+    for (uint32_t j = 0; j < topC && x != 0ull; ++j) {
+      uint64_t const prev = alpaka::atomicMax(acc, &slots[j], x, alpaka::hierarchy::Threads{});
+      if (prev < x)
+        x = prev;  // x took the slot; carry the value it displaced downwards
+    }
+  }
+
+  // K4a. Insert one tile's eligible rows into both endpoints' slot lists.
+  //
+  // The two gates are character for character the ones K6a applies (type != 0, then
+  // `logOdds < weldBar`), so "eligible here" and "eligible in the weld" are the same predicate.
+  struct ChainTopCInsert {
+    ALPAKA_FN_ACC void operator()(Acc1D const& acc,
+                                  ChainEdgesConst tile,
+                                  uint32_t nRows,
+                                  uint32_t nNodes,
+                                  uint32_t topC,
+                                  uint64_t* slotKey,
+                                  uint32_t* census,
+                                  bool doCensus) const {
+      size_t const inBase = static_cast<size_t>(topC) * nNodes;
+
+      for (uint32_t r : cms::alpakatools::uniform_elements(acc, nRows)) {
+        if (tile.type()[r] == 0u)
+          continue;
+        float const lo = tile.logOdds()[r];
+        if (lo < tile.weldBar()[r])
+          continue;
+        uint64_t const key = chainWeldKey(lo, tile.tie()[r]);
+        uint32_t const n = tile.inner()[r];
+        uint32_t const m = tile.outer()[r];
+        ALPAKA_ASSERT_ACC(n < nNodes && m < nNodes);
+        chainTopCInsertKey(acc, slotKey + static_cast<size_t>(n) * topC, topC, key);
+        chainTopCInsertKey(acc, slotKey + inBase + static_cast<size_t>(m) * topC, topC, key);
+        if (doCensus)
+          alpaka::atomicAdd(acc, &census[0], 1u, alpaka::hierarchy::Threads{});
+      }
+    }
+  };
+
+  // K4b. Give every surviving key its endpoint and its family.
+  //
+  // Runs over the SAME tiles a second time, enumerated by K2 and NOT scored -- K5 is 70% of the CPU
+  // chain block and this pass does not need a single logit, which is the whole reason the cap costs a
+  // K2 and not a K5. (It therefore MUST NOT look at logOdds or weldBar: on this pass those columns
+  // hold K2's 0 and whatever the previous pass left behind.) The identification is by the tie word
+  // alone: `tie = stableId[inner] ^ stableId[outer]` is distinct for any two edges sharing an
+  // endpoint -- the property the weld argmax already rests on -- so within one node's slot list the
+  // low 32 bits of a key name the edge, and an INELIGIBLE row simply matches nothing because its tie
+  // is not any node's kept key.
+  //
+  // Idempotent and order-free: every write stores the same value the tile that produced the key would
+  // have stored, so re-running it, or running it while other rows are matching, cannot disagree.
+  struct ChainTopCMatch {
+    ALPAKA_FN_ACC void operator()(Acc1D const& acc,
+                                  ChainEdgesConst tile,
+                                  uint32_t nRows,
+                                  uint32_t nNodes,
+                                  uint32_t topC,
+                                  uint64_t const* slotKey,
+                                  uint32_t* slotEnd,
+                                  uint8_t* slotType) const {
+      size_t const inBase = static_cast<size_t>(topC) * nNodes;
+
+      for (uint32_t r : cms::alpakatools::uniform_elements(acc, nRows)) {
+        uint8_t const type = tile.type()[r];
+        if (type == 0u)
+          continue;
+        uint32_t const tie = tile.tie()[r];
+        uint32_t const n = tile.inner()[r];
+        uint32_t const m = tile.outer()[r];
+
+        size_t const outSlot = static_cast<size_t>(n) * topC;
+        for (uint32_t j = 0; j < topC; ++j)
+          if (static_cast<uint32_t>(slotKey[outSlot + j]) == tie) {
+            slotEnd[outSlot + j] = m;
+            slotType[outSlot + j] = type;
+            break;
+          }
+        size_t const inSlot = inBase + static_cast<size_t>(m) * topC;
+        for (uint32_t j = 0; j < topC; ++j)
+          if (static_cast<uint32_t>(slotKey[inSlot + j]) == tie) {
+            slotEnd[inSlot + j] = n;
+            slotType[inSlot + j] = type;
+            break;
+          }
+      }
+    }
+  };
+
+  // K4c. Sort each node's two lists descending, carrying the endpoint and family with the key.
+  //
+  // The cascade leaves the right SET in unspecified positions, and the positions depend on the atomic
+  // interleaving. Sorting makes the emitted row order a function of the kept set alone, which keeps
+  // the edge array itself reproducible run to run and backend to backend (nothing downstream depends
+  // on a row index, but a reproducible intermediate is worth C^2/2 <= 32 compares per list). Empty
+  // slots hold key 0 and therefore sort to the end.
+  struct ChainTopCSort {
+    ALPAKA_FN_ACC void operator()(Acc1D const& acc,
+                                  uint32_t nNodes,
+                                  uint32_t topC,
+                                  uint64_t* slotKey,
+                                  uint32_t* slotEnd,
+                                  uint8_t* slotType) const {
+      size_t const inBase = static_cast<size_t>(topC) * nNodes;
+
+      for (uint32_t n : cms::alpakatools::uniform_elements(acc, nNodes)) {
+        for (int side = 0; side < 2; ++side) {
+          size_t const b = (side == 0) ? static_cast<size_t>(n) * topC : inBase + static_cast<size_t>(n) * topC;
+          for (uint32_t i = 1; i < topC; ++i) {
+            uint64_t const k = slotKey[b + i];
+            uint32_t const e = slotEnd[b + i];
+            uint8_t const t = slotType[b + i];
+            uint32_t j = i;
+            while (j > 0 && slotKey[b + j - 1] < k) {
+              slotKey[b + j] = slotKey[b + j - 1];
+              slotEnd[b + j] = slotEnd[b + j - 1];
+              slotType[b + j] = slotType[b + j - 1];
+              --j;
+            }
+            slotKey[b + j] = k;
+            slotEnd[b + j] = e;
+            slotType[b + j] = t;
+          }
+        }
+      }
+    }
+  };
+
+  // K4d. How many rows each node contributes, and the duplicate rule.
+  //
+  // An edge kept on both sides must be emitted ONCE: a repeated row would make two rows carry the
+  // same key at the same node, and K6b would then have two winners racing on outWeld[n]. The rule is
+  // "the out-list owns the edge": an in-slot is emitted only if its edge is absent from its INNER
+  // node's out-list, tested on the same tie word K4b matched on. Both lists are final here, so the
+  // test is a pure function of the kept set.
+  //
+  // A slot whose endpoint never got matched (`slotEnd == kChainTopCNoEnd`) is impossible unless two
+  // chain nodes share a stableId, which would already have broken the weld tie-break; it is counted
+  // into census[1] and skipped rather than trusted.
+  static constexpr uint32_t kChainTopCNoEnd = 0xffffffffu;
+
+  // The duplicate rule, shared verbatim by K4d and K4f -- they MUST agree row for row, since K4d's
+  // count is what sizes the array K4f writes into.
+  //
+  // "Does the inner node's out-list already own this edge?" The peer list is sorted descending (K4c)
+  // and an edge carries the SAME 64-bit key in both lists, so the scan stops at the first key below
+  // the one being looked for: typically one or two compares rather than topC. The endpoint is checked
+  // as well as the key, so the answer stays right even if two chain nodes were ever to share a
+  // stableId and collide their tie words.
+  ALPAKA_FN_ACC ALPAKA_FN_INLINE bool chainTopCOwnedByOutList(
+      uint64_t const* slotKey, uint32_t const* slotEnd, size_t peer, uint32_t topC, uint64_t key, uint32_t outerNode) {
+    for (uint32_t q = 0; q < topC; ++q) {
+      uint64_t const pk = slotKey[peer + q];
+      if (pk < key)
+        return false;  // sorted descending: the key is not in this list
+      if (pk == key && slotEnd[peer + q] == outerNode)
+        return true;
+    }
+    return false;
+  }
+
+  struct ChainTopCCount {
+    ALPAKA_FN_ACC void operator()(Acc1D const& acc,
+                                  uint32_t nNodes,
+                                  uint32_t topC,
+                                  uint64_t const* slotKey,
+                                  uint32_t const* slotEnd,
+                                  uint32_t* nodeCount,
+                                  uint32_t* census) const {
+      size_t const inBase = static_cast<size_t>(topC) * nNodes;
+
+      for (uint32_t n : cms::alpakatools::uniform_elements(acc, nNodes)) {
+        uint32_t kept = 0u;
+        size_t const outBase = static_cast<size_t>(n) * topC;
+        for (uint32_t j = 0; j < topC; ++j) {
+          if (slotKey[outBase + j] == 0ull)
+            break;  // sorted descending: the rest are empty too
+          if (slotEnd[outBase + j] == kChainTopCNoEnd) {
+            alpaka::atomicAdd(acc, &census[1], 1u, alpaka::hierarchy::Threads{});
+            continue;
+          }
+          ++kept;
+        }
+        size_t const myInBase = inBase + static_cast<size_t>(n) * topC;
+        for (uint32_t j = 0; j < topC; ++j) {
+          uint64_t const key = slotKey[myInBase + j];
+          if (key == 0ull)
+            break;
+          uint32_t const innerNode = slotEnd[myInBase + j];
+          if (innerNode == kChainTopCNoEnd) {
+            alpaka::atomicAdd(acc, &census[1], 1u, alpaka::hierarchy::Threads{});
+            continue;
+          }
+          if (!chainTopCOwnedByOutList(slotKey, slotEnd, static_cast<size_t>(innerNode) * topC, topC, key, n))
+            ++kept;
+        }
+        nodeCount[n] = kept;
+      }
+    }
+  };
+
+  // K4e. Exclusive prefix of the per-node counts: each node's row base, plus the exact total. Same
+  // one-block shape and the same primitive as ChainPrefixChains, over the same key space.
+  struct ChainTopCPrefix {
+    ALPAKA_FN_ACC void operator()(
+        Acc1D const& acc, uint32_t nNodes, uint32_t const* nodeCount, uint32_t* nodeBase, uint32_t* total) const {
+      // 1-block kernel
+      ALPAKA_ASSERT_ACC((alpaka::getWorkDiv<alpaka::Grid, alpaka::Blocks>(acc)[0u] == 1));
+
+      auto& partial = alpaka::declareSharedVar<uint32_t[2 * kChainScanBlockThreads], __COUNTER__>(acc);
+
+      uint32_t const nWorkers = chainScanWorkerCount(acc);
+      uint32_t const worker = chainScanWorkerIndex(acc);
+      ALPAKA_ASSERT_ACC(nWorkers <= kChainScanBlockThreads);
+
+      uint32_t const chunk = (nNodes + nWorkers - 1u) / nWorkers;
+      uint32_t const begin = (worker * chunk < nNodes) ? worker * chunk : nNodes;
+      uint32_t const end = (begin + chunk < nNodes) ? begin + chunk : nNodes;
+
+      uint32_t local[1] = {0u};
+      for (uint32_t n = begin; n < end; ++n)
+        local[0] += nodeCount[n];
+
+      uint32_t base[1], grand[1];
+      chainScanBlockExclusive<1>(acc, &partial[0], nWorkers, worker, local, base, grand);
+
+      uint32_t running = base[0];
+      for (uint32_t n = begin; n < end; ++n) {
+        nodeBase[n] = running;
+        running += nodeCount[n];
+      }
+
+      alpaka::syncBlockThreads(acc);
+      if (cms::alpakatools::once_per_block(acc))
+        *total = grand[0];
+    }
