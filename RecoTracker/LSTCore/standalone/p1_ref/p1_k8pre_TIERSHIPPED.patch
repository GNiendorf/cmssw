+  auto stats_buf = cms::alpakatools::make_device_buffer<uint32_t[]>(queue_, chainattach::kStats);
+  auto tgtKey_buf = cms::alpakatools::make_device_buffer<uint64_t[]>(queue_, nCands);
+  auto tgtPls_buf = cms::alpakatools::make_device_buffer<int32_t[]>(queue_, nCands);
+  auto tgtLogit_buf = cms::alpakatools::make_device_buffer<float[]>(queue_, nCands);
+  // The -RPSA evidence array of this pass, written and thrown away: see the header comment.
+  auto plsBestScratch_buf = cms::alpakatools::make_device_buffer<uint32_t[]>(queue_, nPls);
+  alpaka::memset(queue_, stats_buf, 0u);
+  alpaka::memset(queue_, tgtKey_buf, 0);  // key 0 = "no pair reached the margin"
+  alpaka::memset(queue_, plsBestScratch_buf, 0u);
+  uint32_t const attachSlices =
+      cms::alpakatools::requires_single_thread_per_block_v<Acc1D> ? 1u : chainAttachScoreSlices();
+  auto const attachScore_workDiv = cms::alpakatools::make_workdiv<Acc1D>(
+      std::max<uint32_t>(max_blocks, (nCands * attachSlices + 255u) / 256u), 256);
+  alpaka::exec<Acc1D>(queue_,
+                      attachScore_workDiv,
+                      ChainAttachScore{},
+                      plsPre,
+                      tgtPre_buf.data(),
+                      nCands,
+                      nCands,  // no aux 4-layer tail: every candidate here is a 5+ layer target
+                      attachGridOffs_->data(),
+                      attachGridItems_->data(),
+                      tgtKey_buf.data(),
+                      plsBestScratch_buf.data(),
+                      static_cast<ChainXcPair*>(nullptr),  // no -XC append from the pre-pass
+                      static_cast<uint32_t*>(nullptr),
+                      0u,
+                      stats_buf.data(),
+                      attachSlices,
+                      chainConfig_);
+  alpaka::exec<Acc1D>(queue_,
+                      chainFlat_workDiv,
+                      ChainAttachUnpackBest{},
+                      tgtKey_buf.data(),
+                      static_cast<uint32_t const*>(nullptr),
+                      tgtPls_buf.data(),
+                      tgtLogit_buf.data(),
+                      nCands,
+                      stats_buf.data());
+  // The one-pLS-one-owner contention, resolved HERE on scratch arrays so that the flat term promotes
+  // only the chain that would really be granted the seed. `targets == nullptr` is the stage-B calling
+  // convention of ChainAttachResolve: the verdicts stay on the position arrays and NOTHING is written
+  // to a chain row -- which is exactly what the pre-pass needs (attachPls must stay -1 until the real
+  // stage A decides it). plsKey is nPls-wide and starts at 0, the "no owner" key.
+  if (contend) {
+    auto plsKey_buf = cms::alpakatools::make_device_buffer<uint64_t[]>(queue_, nPls);
+    auto keep_scratch = cms::alpakatools::make_device_buffer<uint32_t[]>(queue_, nCands);
+    alpaka::memset(queue_, plsKey_buf, 0);
+    alpaka::exec<Acc1D>(queue_,
+                        chainFlat_workDiv,
+                        ChainAttachArgmax{},
+                        tgtPls_buf.data(),
+                        tgtLogit_buf.data(),
+                        nCands,
+                        plsKey_buf.data());
+    alpaka::exec<Acc1D>(queue_,
+                        chainFlat_workDiv,
+                        ChainAttachResolve{},
+                        chainsDC_->view(),
+                        static_cast<uint32_t const*>(nullptr),  // do NOT publish onto the chain rows
+                        tgtPls_buf.data(),
+                        tgtLogit_buf.data(),
+                        nCands,
+                        plsKey_buf.data(),
+                        keep_scratch.data());
+  }
+  alpaka::exec<Acc1D>(queue_,
+                      chainFlat_workDiv,
+                      ChainOrderSeedBonus{},
+                      chainsDC_->view(),
+                      cands_buf.data(),
+                      tgtPls_buf.data(),
+                      nCands,
+                      bonus,
+                      holdDisp);
+
+  // The post-K9 attach builds THE grid (stage-A + bare-T3 union hull) from scratch, so this one has
+  // no reader left: its ~10 MB items payload goes back to the caching allocator before that build,
+  // which is why the peak is unchanged.
+  attachGridOffs_.reset();
+  attachGridItems_.reset();
+  attachGridEntries_ = 0;
+
+  if (timing || objectsStatistics_) {
+    auto stats_h = cms::alpakatools::make_host_buffer<uint32_t[]>(queue_, chainattach::kStats);
+    alpaka::memcpy(queue_, stats_h, stats_buf);
+    alpaka::wait(queue_);
+    uint32_t const* s = stats_h.data();
+    // `confirmed` is the PRE-contention count (ChainAttachUnpackBest's own census); the promoted set is
+    // that minus the contention losers.
+    seedPreSummary_ = std::format("bonus={} contend={} holdDisp={} cands={} confirmed={} cand={} pairs={} dup={}",
+                                  bonus,
+                                  contend ? 1 : 0,
+                                  holdDisp,
+                                  nCands,
+                                  s[3],
+                                  s[1],
+                                  s[2],
+                                  s[10]);
+  }
+}
