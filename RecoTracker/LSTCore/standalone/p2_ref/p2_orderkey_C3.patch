   //   7 K10 layer-slot fallbacks    8 K10 rows that ran out of slots
   static constexpr uint32_t kChainArbStats = 16u;
 
+  // ------------------------------------------------------------------------------------------
+  // THE K9 PRIORITY KEY. One expression, one call site (ChainClaimPrep, phase (b) below).
+  //
+  //   orderKey = score - orderAlpha * max(0, orderHinge - marginX)      the frozen key
+  //              - orderT3FakeMinW * max(0, clamp01(f[20]) - k*max(f[22], f[23]))  } the P2 rank
+  //              - orderT3FakeMaxW * max(0, clamp01(f[21]) - k*max(f[22], f[24]))  } terms, all
+  //              - orderEdgeLogitW * max(0, f[2])                                  } inert at 0
+  //
+  // It is NEVER a threshold -- acceptance cuts on chains.score, which none of this touches (the M9
+  // cross-scale-inversion lesson). Every added term is a PENALTY clamped at >= 0, so a chain with
+  // clean member T3s keeps exactly its frozen key and the weights are a pure re-ranking.
+  //
+  // `k` = orderT3DispCredit is the DISPLACED CREDIT, and it is not optional decoration: WITHOUT it
+  // the two fake-score legs are a prompt-calibrated tax on genuinely displaced tracks, because
+  // fake / prompt / displaced are one softmax, and that cost the displaced efficiency bands on two
+  // independent PU200 samples. The mechanism, the numbers and the measured
+  // jet-gain-versus-displaced-cost trade curve are in the ChainConfig.h block -- do not set the two
+  // weights without reading it. The same block records the two columns that separate core fake from
+  // core truth even better and were REFUSED after measurement (the chain dcaXY, the T3 prompt score),
+  // both for the same reason: they are paid for out of the displaced advantage.
+  //
+  // KEPT AS A FUNCTION ON PURPOSE (P2/P1 coordination, FINDINGS_JETROUND.md): the key used to be one
+  // inline expression inside the claim-prep loop, and two arms of the jet round want to add terms to
+  // it. Anything else that wants to weigh in on the claim priority -- pixel-attach evidence, for
+  // instance -- extends THIS function's argument list rather than adding a second write to the
+  // orderKey column, so the tree keeps exactly one definition of the priority.
+  ALPAKA_FN_ACC ALPAKA_FN_INLINE float chainOrderKeyOf(ChainConfig const& cfg,
+                                                      float score,
+                                                      float marginX,
+                                                      Params_ChainFeat::ArrayFxFeat const& feats) {
+    float key = score - cfg.orderAlpha * chainMaxf(0.f, cfg.orderHinge - marginX);
+    // clamp01 written as min(1, max(0, x)) in this order so a NaN input yields a 0 penalty rather
+    // than propagating into the rank comparator. The credit is subtracted BEFORE the outer max(0,.),
+    // so a chain whose members look real on either class pays nothing at all rather than negatively
+    // (a bonus would let the credit promote chains past the frozen ordering, which is not what this
+    // is for): the terms stay penalties, and k = 0 collapses each of them to the uncredited form.
+    float const credit = chainMaxf(0.f, cfg.orderT3DispCredit);
+    float const cMin = credit * chainMaxf(feats[22], feats[23]);
+    float const cMax = credit * chainMaxf(feats[22], feats[24]);
+    key -= cfg.orderT3FakeMinW * chainMaxf(0.f, chainMinf(1.f, chainMaxf(0.f, feats[20])) - cMin);
+    key -= cfg.orderT3FakeMaxW * chainMaxf(0.f, chainMinf(1.f, chainMaxf(0.f, feats[21])) - cMax);
+    key -= cfg.orderEdgeLogitW * chainMaxf(0.f, feats[2]);
+    return key;
+  }
