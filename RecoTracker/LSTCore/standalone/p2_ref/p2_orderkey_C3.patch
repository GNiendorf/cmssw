diff --git a/RecoTracker/LSTCore/src/alpaka/ChainConfigEnv.h b/RecoTracker/LSTCore/src/alpaka/ChainConfigEnv.h
new file mode 100644
index 00000000000..deacdb29b1d
--- /dev/null
+++ b/RecoTracker/LSTCore/src/alpaka/ChainConfigEnv.h
@@ -0,0 +1,55 @@
+#ifndef RecoTracker_LSTCore_src_alpaka_ChainConfigEnv_h
+#define RecoTracker_LSTCore_src_alpaka_ChainConfigEnv_h
+
+#include <cstdio>
+#include <cstdlib>
+
+#include "RecoTracker/LSTCore/interface/ChainConfig.h"
+
+// Env-knob tuning instrument, restored for the jet round from the A4 original
+// (standalone/nnloop_ref/b1_saved_ChainConfigEnv.h). Applied in the LSTEvent CONSTRUCTOR, not in
+// LST::run: the standalone driver (standalone/bin/lst.cc) constructs LSTEvent DIRECTLY and never
+// calls LST::run, so a hook there is invisible to every standalone measurement.
+//
+// Physics-inert with nothing set -- it is a sequence of "if the variable exists, overwrite" and the
+// CMSSW path sets none of them. Every override PRINTS ONCE, so the ABSENCE of a print is the signal
+// that the variable you thought you set never reached a kernel (that failure mode has cost this
+// project a full tuning cycle before).
+//
+// Shared instrument: any arm adding a ChainConfig knob for a sweep adds its envFloat line HERE
+// rather than inventing a second mechanism.
+namespace lst::chainenv {
+
+  inline void envFloat(char const* name, float& dst) {
+    if (char const* v = std::getenv(name)) {
+      float const before = dst;
+      dst = static_cast<float>(std::atof(v));
+      unsigned h = 0;
+      for (char const* p = name; *p; ++p)
+        h = h * 131u + static_cast<unsigned char>(*p);
+      static bool seen[128] = {};
+      if (!seen[h % 128u]) {
+        seen[h % 128u] = true;
+        std::printf("[chainenv] %s: %g -> %g\n", name, static_cast<double>(before), static_cast<double>(dst));
+        std::fflush(stdout);
+      }
+    }
+  }
+
+  inline void apply(ChainConfig& cfg) {
+    // P2 (jet round): the K9 order-key rank terms. Ranking only -- see the ChainConfig.h block.
+    envFloat("LSTCHAIN_orderT3FakeMinW", cfg.orderT3FakeMinW);
+    envFloat("LSTCHAIN_orderT3FakeMaxW", cfg.orderT3FakeMaxW);
+    envFloat("LSTCHAIN_orderEdgeLogitW", cfg.orderEdgeLogitW);
+    // C3: the displaced credit on the two fake-score legs (0 = uncredited, which FAILED the
+    // displaced gate -- see ChainConfig.h).
+    envFloat("LSTCHAIN_orderT3DispCredit", cfg.orderT3DispCredit);
+    // The two frozen key weights, so that "is the key mis-weighted?" stays answerable without a
+    // rebuild. Measured answer, jets: no -- every alpha other than 10 is neutral-to-negative.
+    envFloat("LSTCHAIN_orderAlpha", cfg.orderAlpha);
+    envFloat("LSTCHAIN_orderHinge", cfg.orderHinge);
+  }
+
+}  // namespace lst::chainenv
+
+#endif
