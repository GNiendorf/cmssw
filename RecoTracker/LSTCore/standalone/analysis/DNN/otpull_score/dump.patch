diff -ruN a/DiagLST/OTPullDiag/plugins/OTPullDiagAnalyzer.cc b/DiagLST/OTPullDiag/plugins/OTPullDiagAnalyzer.cc
--- a/DiagLST/OTPullDiag/plugins/OTPullDiagAnalyzer.cc	1969-12-31 19:00:00.000000000 -0500
+++ b/DiagLST/OTPullDiag/plugins/OTPullDiagAnalyzer.cc	2026-11-02 23:19:57.729112960 -0500
@@ -0,0 +1,401 @@
+// DIAGNOSTIC ONLY (lane itaca_extoff/decision; otpull_score dump record): truth for the LST OT-seeded lookup dump (hltLST diag* vectors) through
+// ClusterTPAssociation; per-TP reco matches from TrackAssociatorEDProducer sim->reco maps. One TTree entry per event.
+#include <algorithm>
+#include <cmath>
+#include <random>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "TTree.h"
+
+#include "CommonTools/UtilAlgos/interface/TFileService.h"
+#include "DataFormats/BeamSpot/interface/BeamSpot.h"
+#include "FWCore/Framework/interface/Event.h"
+#include "FWCore/Framework/interface/Frameworkfwd.h"
+#include "FWCore/Framework/interface/MakerMacros.h"
+#include "FWCore/Framework/interface/one/EDAnalyzer.h"
+#include "FWCore/ParameterSet/interface/ParameterSet.h"
+#include "FWCore/ServiceRegistry/interface/Service.h"
+#include "SimDataFormats/Associations/interface/TrackAssociation.h"
+#include "SimDataFormats/TrackingAnalysis/interface/TrackingParticle.h"
+#include "SimDataFormats/TrackingAnalysis/interface/TrackingParticleFwd.h"
+#include "SimTracker/TrackerHitAssociation/interface/ClusterTPAssociation.h"
+
+namespace {
+  constexpr int kPixBit = 1 << 30;
+  constexpr int kStubBit = 1 << 29;
+  constexpr int kT3I = 16, kT3F = 16, kPairF = 22, kTCI = 28, kPLSI = 6;
+
+  struct Best {
+    int tp = -1;
+    int n = 0;
+    int nAny = 0;
+  };
+}  // namespace
+
+class OTPullDiagAnalyzer : public edm::one::EDAnalyzer<edm::one::SharedResources> {
+public:
+  explicit OTPullDiagAnalyzer(edm::ParameterSet const& ps)
+      : lstLabel_(ps.getParameter<std::string>("lstLabel")),
+        hasLST_(ps.getParameter<bool>("hasDiag")),
+        falseKeep_(ps.getParameter<double>("falsePairKeep")),
+        tpTok_(consumes(ps.getParameter<edm::InputTag>("trackingParticles"))),
+        clTok_(consumes(ps.getParameter<edm::InputTag>("clusterTP"))),
+        bsTok_(consumes(ps.getParameter<edm::InputTag>("beamSpot"))),
+        rng_(12345) {
+    usesResource("TFileService");
+    if (hasLST_) {
+      pairsTok_ = consumes(edm::InputTag(lstLabel_, "diagPairs"));
+      t3iTok_ = consumes(edm::InputTag(lstLabel_, "diagT3i"));
+      t3fTok_ = consumes(edm::InputTag(lstLabel_, "diagT3f"));
+      cellsTok_ = consumes(edm::InputTag(lstLabel_, "diagCells"));
+      cellKeysTok_ = consumes(edm::InputTag(lstLabel_, "diagCellKeys"));
+      tcTok_ = consumes(edm::InputTag(lstLabel_, "diagTC"));
+      plsTok_ = consumes(edm::InputTag(lstLabel_, "diagPLS"));
+      infoTok_ = consumes(edm::InputTag(lstLabel_, "diagInfo"));
+    }
+    for (auto const& t : ps.getParameter<std::vector<edm::InputTag>>("assocs"))
+      assocToks_.push_back(consumes<reco::SimToRecoCollection>(t));
+    nAssoc_ = assocToks_.size();
+    edm::Service<TFileService> fs;
+    tree_ = fs->make<TTree>("ev", "ev");
+    tree_->Branch("run", &run_);
+    tree_->Branch("lumi", &lumi_);
+    tree_->Branch("event", &event_);
+    tree_->Branch("info", &info_);
+    tree_->Branch("tp_key", &tpKey_);
+    tree_->Branch("tp_pt", &tpPt_);
+    tree_->Branch("tp_eta", &tpEta_);
+    tree_->Branch("tp_phi", &tpPhi_);
+    tree_->Branch("tp_vx", &tpVx_);
+    tree_->Branch("tp_vy", &tpVy_);
+    tree_->Branch("tp_vz", &tpVz_);
+    tree_->Branch("tp_dxy", &tpDxy_);
+    tree_->Branch("tp_dz", &tpDz_);
+    tree_->Branch("tp_q", &tpQ_);
+    tree_->Branch("tp_pdg", &tpPdg_);
+    tree_->Branch("tp_sig", &tpSig_);
+    tree_->Branch("tp_nPix", &tpNPix_);
+    tree_->Branch("tp_nOT", &tpNOT_);
+    tree_->Branch("tp_found", &tpFound_);  // nAssoc per TP, flattened
+    tree_->Branch("t3_i", &t3i_);
+    tree_->Branch("t3_f", &t3f_);
+    tree_->Branch("t3_tp", &t3tp_);
+    tree_->Branch("t3_nm", &t3nm_);
+    tree_->Branch("t3_nany", &t3nany_);
+    tree_->Branch("cell_idx", &cellIdx_);
+    tree_->Branch("cell_tp", &cellTp_);
+    tree_->Branch("cell_f", &cellF_);
+    tree_->Branch("cell_ntrue1", &cellNTrue1_);
+    tree_->Branch("pair_f", &pairF_);
+    tree_->Branch("pair_ctp", &pairCtp_);
+    tree_->Branch("pair_cf", &pairCF_);
+    tree_->Branch("pair_otp", &pairOtp_);
+    tree_->Branch("pair_onm", &pairOnm_);
+    tree_->Branch("pair_w", &pairW_);
+    tree_->Branch("tc_type", &tcType_);
+    tree_->Branch("tc_hk", &tcHk_);
+    tree_->Branch("tc_seed", &tcSeed_);
+    tree_->Branch("tc_nOT", &tcNOT_);
+    tree_->Branch("tc_nPix", &tcNPix_);
+    tree_->Branch("tc_stub", &tcStub_);
+    tree_->Branch("tc_tp", &tcTp_);
+    tree_->Branch("tc_nm", &tcNm_);
+    tree_->Branch("tc_tpOT", &tcTpOT_);
+    tree_->Branch("tc_nmOT", &tcNmOT_);
+    tree_->Branch("tc_tpPix", &tcTpPix_);
+    tree_->Branch("tc_nmPix", &tcNmPix_);
+    tree_->Branch("pls_seed", &plsSeed_);
+    tree_->Branch("pls_nh", &plsNh_);
+    tree_->Branch("pls_tp", &plsTp_);
+    tree_->Branch("pls_nm", &plsNm_);
+    tree_->Branch("pls_npix", &plsNpix_);
+  }
+
+  static void fillDescriptions(edm::ConfigurationDescriptions& descriptions) {
+    edm::ParameterSetDescription desc;
+    desc.add<std::string>("lstLabel", "hltLST");
+    desc.add<bool>("hasDiag", true);
+    desc.add<double>("falsePairKeep", 1.0);
+    desc.add<edm::InputTag>("trackingParticles", edm::InputTag("mix", "MergedTrackTruth"));
+    desc.add<edm::InputTag>("clusterTP", edm::InputTag("hltTPClusterProducer"));
+    desc.add<edm::InputTag>("beamSpot", edm::InputTag("hltOnlineBeamSpot"));
+    desc.add<std::vector<edm::InputTag>>("assocs", {});
+    descriptions.addWithDefaultLabel(desc);
+  }
+
+private:
+  std::vector<int> const& tpsOf(int key) const {
+    static const std::vector<int> empty;
+    if (key < 0)
+      return empty;
+    if (key & kPixBit) {
+      auto it = pixMap_.find(static_cast<uint32_t>(key & (kStubBit - 1)));
+      return it == pixMap_.end() ? empty : it->second;
+    }
+    auto it = otMap_.find(static_cast<uint32_t>(key));
+    return it == otMap_.end() ? empty : it->second;
+  }
+
+  Best best(int const* keys, int n) const {
+    Best b;
+    std::vector<std::pair<int, int>> cnt;
+    for (int i = 0; i < n; ++i) {
+      if (keys[i] < 0)
+        continue;
+      auto const& v = tpsOf(keys[i]);
+      if (!v.empty())
+        ++b.nAny;
+      for (int tp : v) {
+        auto it = std::find_if(cnt.begin(), cnt.end(), [tp](auto const& p) { return p.first == tp; });
+        if (it == cnt.end())
+          cnt.emplace_back(tp, 1);
+        else
+          ++it->second;
+      }
+    }
+    for (auto const& p : cnt)
+      if (p.second > b.n) {
+        b.n = p.second;
+        b.tp = p.first;
+      }
+    return b;
+  }
+
+  int common2(int k0, int k1) const {
+    auto const& a = tpsOf(k0);
+    auto const& b = tpsOf(k1);
+    for (int x : a)
+      for (int y : b)
+        if (x == y)
+          return x;
+    return -1;
+  }
+
+  void analyze(edm::Event const& iEvent, edm::EventSetup const&) override {
+    // events that do not reach tracking have no LST products: skipped
+    if (hasLST_ && !iEvent.getHandle(infoTok_).isValid())
+      return;
+    run_ = iEvent.id().run();
+    lumi_ = iEvent.id().luminosityBlock();
+    event_ = iEvent.id().event();
+    for (auto* v : {&tpKey_, &tpQ_, &tpPdg_, &tpSig_, &tpNPix_, &tpNOT_, &tpFound_, &t3i_, &t3tp_, &t3nm_, &t3nany_,
+                    &cellIdx_, &cellTp_, &pairCtp_, &pairOtp_, &pairOnm_, &tcType_, &tcHk_, &tcSeed_, &tcNOT_, &tcNPix_, &tcStub_,
+                    &tcTp_, &tcNm_, &tcTpOT_, &tcNmOT_, &tcTpPix_, &tcNmPix_, &plsSeed_, &plsNh_, &plsTp_, &plsNm_,
+                    &plsNpix_, &info_})
+      v->clear();
+    for (auto* v : {&tpPt_, &tpEta_, &tpPhi_, &tpVx_, &tpVy_, &tpVz_, &tpDxy_, &tpDz_, &t3f_, &cellF_, &pairF_, &pairW_, &pairCF_})
+      v->clear();
+    cellNTrue1_ = 0;
+
+    auto const& clTP = iEvent.get(clTok_);
+    pixMap_.clear();
+    otMap_.clear();
+    std::unordered_map<int, int> nPix, nOT;
+    for (auto const& p : clTP) {
+      auto const& c = p.first;
+      int const tk = static_cast<int>(p.second.key());
+      if (c.isPixel()) {
+        pixMap_[c.index()].push_back(tk);
+        ++nPix[tk];
+      } else if (c.isPhase2()) {
+        otMap_[c.index()].push_back(tk);
+        ++nOT[tk];
+      }
+    }
+    auto const tpH = iEvent.getHandle(tpTok_);
+    auto const& tps = *tpH;
+    auto const& bs = iEvent.get(bsTok_);
+    std::vector<reco::SimToRecoCollection const*> assocs;
+    for (auto const& t : assocToks_) {
+      auto h = iEvent.getHandle(t);
+      assocs.push_back(h.isValid() ? h.product() : nullptr);
+    }
+    for (size_t i = 0; i < tps.size(); ++i) {
+      auto const& tp = tps[i];
+      if (tp.charge() == 0 || tp.pt() < 0.7 || std::abs(tp.eta()) > 4.5 || tp.eventId().bunchCrossing() != 0)
+        continue;
+      tpKey_.push_back(i);
+      tpPt_.push_back(tp.pt());
+      tpEta_.push_back(tp.eta());
+      tpPhi_.push_back(tp.phi());
+      tpVx_.push_back(tp.vx());
+      tpVy_.push_back(tp.vy());
+      tpVz_.push_back(tp.vz());
+      const double dx = tp.vx() - bs.x0(), dy = tp.vy() - bs.y0(), dz = tp.vz() - bs.z0();
+      const double px = tp.px(), py = tp.py(), pz = tp.pz(), pt = tp.pt();
+      tpDxy_.push_back((-dx * py + dy * px) / pt);
+      tpDz_.push_back(dz - (dx * px + dy * py) / pt * (pz / pt));
+      tpQ_.push_back(tp.charge());
+      tpPdg_.push_back(tp.pdgId());
+      tpSig_.push_back(tp.eventId().event() == 0 ? 1 : 0);
+      tpNPix_.push_back(nPix.count(i) ? nPix[i] : 0);
+      tpNOT_.push_back(nOT.count(i) ? nOT[i] : 0);
+      TrackingParticleRef ref(tpH, i);
+      for (auto const* a : assocs) {
+        int f = -1;
+        if (a) {
+          auto it = a->find(ref);
+          f = (it != a->end() && !it->val.empty()) ? 1 : 0;
+        }
+        tpFound_.push_back(f);
+      }
+    }
+
+    if (hasLST_) {
+      auto const& info = iEvent.get(infoTok_);
+      info_ = info;
+      auto const& t3i = iEvent.get(t3iTok_);
+      auto const& t3f = iEvent.get(t3fTok_);
+      auto const& cells = iEvent.get(cellsTok_);
+      auto const& ckeys = iEvent.get(cellKeysTok_);
+      auto const& pairs = iEvent.get(pairsTok_);
+      auto const& tcs = iEvent.get(tcTok_);
+      auto const& pls = iEvent.get(plsTok_);
+      // T3 truth over its 6 OT hits; t -> best (for pairs)
+      std::unordered_map<int, std::pair<int, int>> t3Truth;
+      const int nT3 = t3i.size() / kT3I;
+      for (int r = 0; r < nT3; ++r) {
+        int const* oi = &t3i[kT3I * r];
+        Best b = best(oi + 9, 6);
+        if (oi[8] >= 1)
+          t3Truth[oi[0]] = {b.tp, b.n};
+        if (oi[8] >= 1 || b.n >= 4) {
+          t3i_.insert(t3i_.end(), oi, oi + kT3I);
+          t3f_.insert(t3f_.end(), &t3f[kT3F * r], &t3f[kT3F * r] + kT3F);
+          t3tp_.push_back(b.tp);
+          t3nm_.push_back(b.n);
+          t3nany_.push_back(b.nAny);
+        }
+      }
+      // TC truth
+      const int nTC = tcs.size() / kTCI;
+      std::vector<std::pair<int, int>> tcTruthOT(nTC, {-1, 0});
+      for (int r = 0; r < nTC; ++r) {
+        int const* o = &tcs[kTCI * r];
+        std::vector<int> ot, pix;
+        int stub = 0;
+        for (int j = 2; j < kTCI; ++j) {
+          if (o[j] < 0)
+            continue;
+          if (o[j] & kPixBit) {
+            pix.push_back(o[j]);
+            if (o[j] & kStubBit)
+              stub = 1;
+          } else
+            ot.push_back(o[j]);
+        }
+        std::vector<int> all(ot);
+        all.insert(all.end(), pix.begin(), pix.end());
+        Best ba = best(all.data(), all.size()), bo = best(ot.data(), ot.size()), bp = best(pix.data(), pix.size());
+        tcHk_.insert(tcHk_.end(), o + 2, o + kTCI);
+        tcType_.push_back(o[0]);
+        tcSeed_.push_back(o[1]);
+        tcNOT_.push_back(ot.size());
+        tcNPix_.push_back(pix.size());
+        tcStub_.push_back(stub);
+        tcTp_.push_back(ba.tp);
+        tcNm_.push_back(ba.n);
+        tcTpOT_.push_back(bo.tp);
+        tcNmOT_.push_back(bo.n);
+        tcTpPix_.push_back(bp.tp);
+        tcNmPix_.push_back(bp.n);
+        tcTruthOT[r] = {bo.tp, bo.n};
+      }
+      const int nPLS = pls.size() / kPLSI;
+      for (int s = 0; s < nPLS; ++s) {
+        int const* o = &pls[kPLSI * s];
+        Best b = best(o + 2, 4);
+        int np = 0;
+        for (int j = 2; j < kPLSI; ++j)
+          np += (o[j] >= 0 && (o[j] & kPixBit)) ? 1 : 0;
+        plsSeed_.push_back(o[0]);
+        plsNh_.push_back(o[1]);
+        plsTp_.push_back(b.tp);
+        plsNm_.push_back(b.n);
+        plsNpix_.push_back(np);
+      }
+      // cells: truth of every binned cell (kept: true ones)
+      const int nCells = cells.size() / 6;
+      std::vector<int> cellTP(nCells, -1);
+      for (int c = 0; c < nCells && 2 * c + 1 < static_cast<int>(ckeys.size()); ++c) {
+        const int k0 = ckeys[2 * c] >= 0 ? (ckeys[2 * c] | kPixBit) : -1;
+        const int k1 = ckeys[2 * c + 1] >= 0 ? (ckeys[2 * c + 1] | kPixBit) : -1;
+        cellTP[c] = common2(k0, k1);
+        if (cellTP[c] < 0 && (!tpsOf(k0).empty() || !tpsOf(k1).empty()))
+          ++cellNTrue1_;
+        if (cellTP[c] >= 0) {
+          cellIdx_.push_back(c);
+          cellTp_.push_back(cellTP[c]);
+          cellF_.insert(cellF_.end(), &cells[6 * c], &cells[6 * c] + 6);
+        }
+      }
+      // pairs
+      std::uniform_real_distribution<double> u(0., 1.);
+      const int nP = pairs.size() / kPairF;
+      for (int k = 0; k < nP; ++k) {
+        float const* o = &pairs[kPairF * k];
+        const int id = static_cast<int>(o[0]), c = static_cast<int>(o[1]);
+        const bool isTC = false;  // only T3 pairs are dumped
+        std::pair<int, int> ot{-1, 0};
+        if (isTC) {
+          if (id < nTC)
+            ot = tcTruthOT[id];
+        } else {
+          auto it = t3Truth.find(id);
+          if (it != t3Truth.end())
+            ot = it->second;
+        }
+        const int ctp = (c >= 0 && c < nCells) ? cellTP[c] : -1;
+        const bool anyTrue = (ctp >= 0 && ot.first == ctp);
+        double w = 1.;
+        if (!anyTrue && falseKeep_ < 1.) {
+          if (u(rng_) > falseKeep_)
+            continue;
+          w = 1. / falseKeep_;
+        }
+        pairF_.insert(pairF_.end(), o, o + kPairF);
+        if (c >= 0 && c < nCells)
+          pairCF_.insert(pairCF_.end(), &cells[6 * c], &cells[6 * c] + 6);
+        else
+          pairCF_.insert(pairCF_.end(), 6, 0.f);
+        pairCtp_.push_back(ctp);
+        pairOtp_.push_back(ot.first);
+        pairOnm_.push_back(ot.second);
+        pairW_.push_back(w);
+      }
+    }
+    tree_->Fill();
+  }
+
+  std::string lstLabel_;
+  bool hasLST_;
+  double falseKeep_;
+  edm::EDGetTokenT<TrackingParticleCollection> tpTok_;
+  edm::EDGetTokenT<ClusterTPAssociation> clTok_;
+  edm::EDGetTokenT<reco::BeamSpot> bsTok_;
+  edm::EDGetTokenT<std::vector<float>> pairsTok_, t3fTok_, cellsTok_;
+  edm::EDGetTokenT<std::vector<int>> t3iTok_, cellKeysTok_, tcTok_, plsTok_, infoTok_;
+  std::vector<edm::EDGetTokenT<reco::SimToRecoCollection>> assocToks_;
+  size_t nAssoc_ = 0;
+  std::mt19937_64 rng_;
+  std::unordered_map<uint32_t, std::vector<int>> pixMap_, otMap_;
+  TTree* tree_;
+  unsigned int run_, lumi_;
+  unsigned long long event_;
+  std::vector<int> info_;
+  std::vector<int> tpKey_, tpQ_, tpPdg_, tpSig_, tpNPix_, tpNOT_, tpFound_;
+  std::vector<float> tpPt_, tpEta_, tpPhi_, tpVx_, tpVy_, tpVz_, tpDxy_, tpDz_;
+  std::vector<int> t3i_, t3tp_, t3nm_, t3nany_;
+  std::vector<float> t3f_;
+  std::vector<int> cellIdx_, cellTp_;
+  std::vector<float> cellF_;
+  int cellNTrue1_ = 0;
+  std::vector<float> pairF_, pairW_, pairCF_;
+  std::vector<int> pairCtp_, pairOtp_, pairOnm_;
+  std::vector<int> tcType_, tcHk_, tcSeed_, tcNOT_, tcNPix_, tcStub_, tcTp_, tcNm_, tcTpOT_, tcNmOT_, tcTpPix_, tcNmPix_;
+  std::vector<int> plsSeed_, plsNh_, plsTp_, plsNm_, plsNpix_;
+};
+
+DEFINE_FWK_MODULE(OTPullDiagAnalyzer);
diff -ruN a/DiagLST/OTPullDiag/plugins/OTPullPairDump.cc b/DiagLST/OTPullDiag/plugins/OTPullPairDump.cc
--- a/DiagLST/OTPullDiag/plugins/OTPullPairDump.cc	1969-12-31 19:00:00.000000000 -0500
+++ b/DiagLST/OTPullDiag/plugins/OTPullPairDump.cc	2026-11-02 23:26:11.604073038 -0500
@@ -0,0 +1,213 @@
+// DUMP PATCH ONLY (standalone/analysis/DNN/otpull_score): truth for the otpull pair dump of hltLST (diagPairs, diagT3i,
+// diagCellKeys) from the compact cluster truth of a training cache (LocalVal/PttTruth CompactClusterTruthProducer):
+// clusters are matched by (detId, position) to the clusters of this job, whose indices are LST's hit keys (OT: the
+// hltSiPhase2Clusters key; pixel: the hltSiPixelClusters key). One TTree entry per event that reaches tracking.
+#include <algorithm>
+#include <random>
+#include <unordered_map>
+#include <vector>
+
+#include "TTree.h"
+
+#include "CommonTools/UtilAlgos/interface/TFileService.h"
+#include "DataFormats/Common/interface/DetSetVectorNew.h"
+#include "DataFormats/Phase2TrackerCluster/interface/Phase2TrackerCluster1D.h"
+#include "DataFormats/SiPixelCluster/interface/SiPixelCluster.h"
+#include "FWCore/Framework/interface/Event.h"
+#include "FWCore/Framework/interface/MakerMacros.h"
+#include "FWCore/Framework/interface/one/EDAnalyzer.h"
+#include "FWCore/ParameterSet/interface/ParameterSet.h"
+#include "FWCore/ServiceRegistry/interface/Service.h"
+
+namespace {
+  constexpr int kT3I = 16, kPairF = 22;
+  using Key = unsigned long long;
+  Key pk(unsigned int det, unsigned int pos) { return (static_cast<Key>(det) << 32) | pos; }
+}  // namespace
+
+class OTPullPairDump : public edm::one::EDAnalyzer<edm::one::SharedResources> {
+public:
+  explicit OTPullPairDump(edm::ParameterSet const& ps)
+      : pairsTok_(consumes(ps.getParameter<edm::InputTag>("pairs"))),
+        t3iTok_(consumes(ps.getParameter<edm::InputTag>("t3i"))),
+        cellKeysTok_(consumes(ps.getParameter<edm::InputTag>("cellKeys"))),
+        pixTok_(consumes(ps.getParameter<edm::InputTag>("pixelClusters"))),
+        otTok_(consumes(ps.getParameter<edm::InputTag>("phase2OTClusters"))),
+        falseKeep_(ps.getParameter<double>("falsePairKeep")),
+        rng_(12345) {
+    auto const tr = ps.getParameter<std::string>("truthLabel");
+    pixDetTok_ = consumes(edm::InputTag(tr, "pixDet"));
+    pixPosTok_ = consumes(edm::InputTag(tr, "pixPos"));
+    otDetTok_ = consumes(edm::InputTag(tr, "otDet"));
+    otPosTok_ = consumes(edm::InputTag(tr, "otPos"));
+    pixTPTok_ = consumes(edm::InputTag(tr, "pixTP"));
+    otTPTok_ = consumes(edm::InputTag(tr, "otTP"));
+    tpEvTok_ = consumes(edm::InputTag(tr, "tpEvent"));
+    tpBxTok_ = consumes(edm::InputTag(tr, "tpBx"));
+    tpPtTok_ = consumes(edm::InputTag(tr, "tpPt"));
+    tpVxTok_ = consumes(edm::InputTag(tr, "tpVx"));
+    tpVyTok_ = consumes(edm::InputTag(tr, "tpVy"));
+    usesResource("TFileService");
+    edm::Service<TFileService> fs;
+    tree_ = fs->make<TTree>("ev", "ev");
+    tree_->Branch("run", &run_);
+    tree_->Branch("lumi", &lumi_);
+    tree_->Branch("event", &event_);
+    tree_->Branch("tp_key", &tpKey_);
+    tree_->Branch("tp_pt", &tpPt_);
+    tree_->Branch("tp_vx", &tpVx_);
+    tree_->Branch("tp_vy", &tpVy_);
+    tree_->Branch("tp_sig", &tpSig_);
+    tree_->Branch("pair_f", &pairF_);
+    tree_->Branch("pair_ctp", &pairCtp_);
+    tree_->Branch("pair_otp", &pairOtp_);
+    tree_->Branch("pair_onm", &pairOnm_);
+    tree_->Branch("pair_w", &pairW_);
+    tree_->Branch("n_match", &nMatch_);
+  }
+
+  static void fillDescriptions(edm::ConfigurationDescriptions& descriptions) {
+    edm::ParameterSetDescription desc;
+    desc.add<edm::InputTag>("pairs", edm::InputTag("hltLST", "diagPairs"));
+    desc.add<edm::InputTag>("t3i", edm::InputTag("hltLST", "diagT3i"));
+    desc.add<edm::InputTag>("cellKeys", edm::InputTag("hltLST", "diagCellKeys"));
+    desc.add<edm::InputTag>("pixelClusters", edm::InputTag("hltSiPixelClusters"));
+    desc.add<edm::InputTag>("phase2OTClusters", edm::InputTag("hltSiPhase2Clusters"));
+    desc.add<std::string>("truthLabel", "pttTruth");
+    desc.add<double>("falsePairKeep", 1.0);
+    descriptions.addWithDefaultLabel(desc);
+  }
