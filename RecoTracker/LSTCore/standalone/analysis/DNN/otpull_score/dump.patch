+private:
+  void analyze(edm::Event const& iEvent, edm::EventSetup const&) override {
+    auto hPairs = iEvent.getHandle(pairsTok_);
+    if (!hPairs.isValid())
+      return;  // the event does not reach tracking
+    run_ = iEvent.id().run();
+    lumi_ = iEvent.id().luminosityBlock();
+    event_ = iEvent.id().event();
+    for (auto* v : {&tpKey_, &tpSig_, &pairCtp_, &pairOtp_, &pairOnm_, &nMatch_})
+      v->clear();
+    for (auto* v : {&tpPt_, &tpVx_, &tpVy_, &pairF_, &pairW_})
+      v->clear();
+    // truth: (det, pos) -> slim TPs, then this job's cluster keys -> slim TPs
+    auto buildMap = [](auto const& det, auto const& pos, auto const& tp) {
+      std::unordered_map<Key, std::vector<int>> m;
+      m.reserve(det.size());
+      for (size_t k = 0; k < det.size(); ++k)
+        m[pk(det[k], pos[k])].push_back(tp[k]);
+      return m;
+    };
+    auto const pixT = buildMap(iEvent.get(pixDetTok_), iEvent.get(pixPosTok_), iEvent.get(pixTPTok_));
+    auto const otT = buildMap(iEvent.get(otDetTok_), iEvent.get(otPosTok_), iEvent.get(otTPTok_));
+    auto const hPix = iEvent.getHandle(pixTok_);
+    auto const hOT = iEvent.getHandle(otTok_);
+    std::vector<std::vector<int> const*> pixKey(hPix->dataSize(), nullptr), otKey(hOT->dataSize(), nullptr);
+    int nm[2] = {0, 0};
+    for (auto ds = hPix->begin(); ds != hPix->end(); ++ds)
+      for (auto cl = ds->begin(); cl != ds->end(); ++cl) {
+        auto it = pixT.find(pk(ds->detId(), (static_cast<unsigned int>(cl->minPixelRow()) << 16) | cl->minPixelCol()));
+        if (it != pixT.end()) {
+          pixKey[edmNew::makeRefTo(hPix, cl).key()] = &it->second;
+          ++nm[0];
+        }
+      }
+    for (auto ds = hOT->begin(); ds != hOT->end(); ++ds)
+      for (auto cl = ds->begin(); cl != ds->end(); ++cl) {
+        auto it = otT.find(pk(ds->detId(), (cl->column() << 16) | cl->firstStrip()));
+        if (it != otT.end()) {
+          otKey[edmNew::makeRefTo(hOT, cl).key()] = &it->second;
+          ++nm[1];
+        }
+      }
+    nMatch_ = {nm[0], static_cast<int>(pixT.size()), nm[1], static_cast<int>(otT.size())};
+    auto const& tev = iEvent.get(tpEvTok_);
+    auto const& tbx = iEvent.get(tpBxTok_);
+    auto const& tpt = iEvent.get(tpPtTok_);
+    auto const& tvx = iEvent.get(tpVxTok_);
+    auto const& tvy = iEvent.get(tpVyTok_);
+    for (size_t i = 0; i < tpt.size(); ++i) {
+      tpKey_.push_back(i);
+      tpPt_.push_back(tpt[i]);
+      tpVx_.push_back(tvx[i]);
+      tpVy_.push_back(tvy[i]);
+      tpSig_.push_back(tev[i] == 0 && tbx[i] == 0 ? 1 : 0);
+    }
+    static const std::vector<int> empty;
+    auto tpsOT = [&](int key) -> std::vector<int> const& {
+      return (key >= 0 && key < static_cast<int>(otKey.size()) && otKey[key]) ? *otKey[key] : empty;
+    };
+    auto tpsPix = [&](int key) -> std::vector<int> const& {
+      return (key >= 0 && key < static_cast<int>(pixKey.size()) && pixKey[key]) ? *pixKey[key] : empty;
+    };
+    // T3 truth: the particle with the most of its 6 OT hits
+    auto const& t3i = iEvent.get(t3iTok_);
+    std::unordered_map<int, std::pair<int, int>> t3Truth;
+    for (size_t r = 0; r < t3i.size() / kT3I; ++r) {
+      int const* oi = &t3i[kT3I * r];
+      if (oi[8] < 1)
+        continue;  // not searched
+      std::vector<std::pair<int, int>> cnt;
+      for (int j = 0; j < 6; ++j)
+        for (int tp : tpsOT(oi[9 + j])) {
+          auto it = std::find_if(cnt.begin(), cnt.end(), [tp](auto const& p) { return p.first == tp; });
+          if (it == cnt.end())
+            cnt.emplace_back(tp, 1);
+          else
+            ++it->second;
+        }
+      std::pair<int, int> b{-1, 0};
+      for (auto const& p : cnt)
+        if (p.second > b.second)
+          b = p;
+      t3Truth[oi[0]] = b;
+    }
+    auto const& ckeys = iEvent.get(cellKeysTok_);
+    auto const& pairs = *hPairs;
+    std::uniform_real_distribution<double> u(0., 1.);
+    for (size_t k = 0; k < pairs.size() / kPairF; ++k) {
+      float const* o = &pairs[kPairF * k];
+      const int id = static_cast<int>(o[0]), c = static_cast<int>(o[1]);
+      int ctp = -1;
+      if (c >= 0 && 2 * c + 1 < static_cast<int>(ckeys.size())) {
+        auto const& a = tpsPix(ckeys[2 * c]);
+        auto const& b = tpsPix(ckeys[2 * c + 1]);
+        for (int x : a)
+          if (ctp < 0 && std::find(b.begin(), b.end(), x) != b.end())
+            ctp = x;
+      }
+      auto it = t3Truth.find(id);
+      const std::pair<int, int> ot = it == t3Truth.end() ? std::pair<int, int>{-1, 0} : it->second;
+      const bool isTrue = ctp >= 0 && ot.first == ctp;
+      double w = 1.;
+      if (!isTrue && falseKeep_ < 1.) {
+        if (u(rng_) > falseKeep_)
+          continue;
+        w = 1. / falseKeep_;
+      }
+      pairF_.insert(pairF_.end(), o, o + kPairF);
+      pairCtp_.push_back(ctp);
+      pairOtp_.push_back(ot.first);
+      pairOnm_.push_back(ot.second);
+      pairW_.push_back(w);
+    }
+    tree_->Fill();
+  }
+
+  edm::EDGetTokenT<std::vector<float>> pairsTok_;
+  edm::EDGetTokenT<std::vector<int>> t3iTok_, cellKeysTok_;
+  edm::EDGetTokenT<edmNew::DetSetVector<SiPixelCluster>> pixTok_;
+  edm::EDGetTokenT<edmNew::DetSetVector<Phase2TrackerCluster1D>> otTok_;
+  edm::EDGetTokenT<std::vector<unsigned int>> pixDetTok_, pixPosTok_, otDetTok_, otPosTok_;
+  edm::EDGetTokenT<std::vector<int>> pixTPTok_, otTPTok_, tpEvTok_, tpBxTok_;
+  edm::EDGetTokenT<std::vector<float>> tpPtTok_, tpVxTok_, tpVyTok_;
+  double falseKeep_;
+  std::mt19937_64 rng_;
+  TTree* tree_;
+  unsigned int run_, lumi_;
+  unsigned long long event_;
+  std::vector<int> tpKey_, tpSig_, pairCtp_, pairOtp_, pairOnm_, nMatch_;
+  std::vector<float> tpPt_, tpVx_, tpVy_, pairF_, pairW_;
+};
+
+DEFINE_FWK_MODULE(OTPullPairDump);
