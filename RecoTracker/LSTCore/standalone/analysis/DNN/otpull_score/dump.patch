+#ifndef RecoTracker_LSTCore_src_alpaka_OTPullDiag_h
+#define RecoTracker_LSTCore_src_alpaka_OTPullDiag_h
+
+// DIAGNOSTIC PATCH ONLY (lane itaca_extoff/decision): dump kernels for the OT-seeded lookup study.
+#include "OTPull.h"
+
+namespace ALPAKA_ACCELERATOR_NAMESPACE::lst {
+
+  constexpr unsigned int kDiagT3I = 16;
+  constexpr unsigned int kDiagT3F = 16;
+  constexpr unsigned int kDiagTCI = 2 + Params_TC::kLayers * Params_TC::kHitsPerLayer;
+  constexpr unsigned int kDiagPLSI = 2 + kMaxPLSHitsInHitsSoA;
+  constexpr int kDiagPixBit = 1 << 30;
+  constexpr int kDiagStubBit = 1 << 29;  // pixel stub key (flagged TC pixel slot)
+
+  // hit key with detector flag: OT cluster key, or pixel cluster key | kDiagPixBit; -1 empty, -2 out of range
+  ALPAKA_FN_ACC ALPAKA_FN_INLINE int diagHitKey(
+      unsigned int ih, HitsBaseConst hits, HitsITConst hitsIT, unsigned int nHitsOT, unsigned int nHitsIT) {
+    if (ih == kTCEmptyHitIdx)
+      return -1;
+    if (ih & kOTPullPixFlag)
+      return static_cast<int>((ih & ~kOTPullPixFlag) | kDiagPixBit | kDiagStubBit);
+    if (ih < nHitsOT)
+      return static_cast<int>(ih);
+    if (ih - nHitsOT >= nHitsIT)
+      return -2;
+    const unsigned int key = hitsIT.idxs()[ih - nHitsOT];
+    const unsigned int sub = (hits.detid()[ih] >> 25) & 7u;
+    return sub >= 3 ? static_cast<int>(key) : static_cast<int>(key | kDiagPixBit);
+  }
+
+  struct OTPullDiagT3 {
+    ALPAKA_FN_ACC void operator()(Acc1D const& acc,
+                                  ModulesConst modules,
+                                  ObjectRangesConst ranges,
+                                  MiniDoubletsConst mds,
+                                  SegmentsConst segments,
+                                  TripletsConst triplets,
+                                  TripletsOccupancyConst tripletsOcc,
+                                  uint16_t nLowerModules,
+                                  unsigned int nTripletSlots,
+                                  const uint8_t* used,
+                                  unsigned int nHitsOT,
+                                  const int* bestCell,
+                                  const float* bestChi2,
+                                  const unsigned long long* cellBest,
+                                  const unsigned long long* hitBest,
+                                  int* outI,
+                                  float* outF,
+                                  unsigned int* outN,
+                                  unsigned int cap) const {
+      for (unsigned int t : cms::alpakatools::uniform_elements(acc, nTripletSlots)) {
+        const uint16_t lm = triplets.lowerModuleIndices()[t][0];
+        if (lm >= nLowerModules)
+          continue;
+        const int off = ranges.tripletModuleIndices()[lm];
+        if (off < 0 || t < static_cast<unsigned int>(off) || t - off >= tripletsOcc.nTriplets()[lm])
+          continue;
+        const unsigned int s0 = triplets.segmentIndices()[t][0], s1 = triplets.segmentIndices()[t][1];
+        const unsigned int md[3] = {
+            segments.mdIndices()[s0][0], segments.mdIndices()[s0][1], segments.mdIndices()[s1][1]};
+        unsigned int h[6];
+        for (int k = 0; k < 3; ++k) {
+          h[2 * k] = mds.anchorHitIndices()[md[k]];
+          h[2 * k + 1] = mds.outerHitIndices()[md[k]];
+        }
+        int fr = -1;
+        if (used) {
+          fr = 1;
+          for (int k = 0; k < 6; ++k)
+            if (h[k] < nHitsOT && used[h[k]])
+              fr = 0;
+        }
+        const bool bl12 = modules.subdets()[lm] == Barrel && (modules.layers()[lm] == 1 || modules.layers()[lm] == 2);
+        const bool partOf = triplets.partOfPT5()[t] || triplets.partOfT5()[t] || triplets.partOfPT3()[t];
+        int status = 0;
+        const int bc = (bestCell && bl12 && !partOf && fr == 1) ? bestCell[t] : -1;
+        if (bl12 && !partOf && fr == 1)
+          status = 1;
+        if (status == 1 && bc >= 0) {
+          status = 2;
+          const unsigned long long key = otpullKey(bestChi2[t], t);
+          if (cellBest[bc] == key) {
+            status = 3;
+            bool own = true;
+            for (int k = 0; k < 3; ++k)
+              own = own && (h[2 * k] >= nHitsOT || hitBest[h[2 * k]] == key);
+            if (own)
+              status = 4;
+          }
+        }
+        const unsigned int k = alpaka::atomicAdd(acc, outN, 1u, alpaka::hierarchy::Blocks{});
+        if (k >= cap)
+          continue;
+        int* oi = outI + kDiagT3I * k;
+        float* of = outF + kDiagT3F * k;
+        oi[0] = static_cast<int>(t);
+        oi[1] = static_cast<int>(modules.subdets()[lm]);
+        oi[2] = static_cast<int>(modules.layers()[lm]);
+        oi[3] = triplets.partOfPT5()[t];
+        oi[4] = triplets.partOfT5()[t];
+        oi[5] = triplets.partOfPT3()[t];
+        oi[6] = fr;
+        oi[7] = bc;
+        oi[8] = status;
+        for (int j = 0; j < 6; ++j)
+          oi[9 + j] = static_cast<int>(h[j]);
+        const uint16_t lm3 = triplets.lowerModuleIndices()[t][2];
+        oi[15] = static_cast<int>(modules.subdets()[lm3]) * 100 + static_cast<int>(modules.layers()[lm3]);
+        of[0] = bc >= 0 ? bestChi2[t] : -1.f;
+        of[1] = triplets.centerX()[t];
+        of[2] = triplets.centerY()[t];
+        of[3] = triplets.radius()[t];
+        for (int j = 0; j < 3; ++j) {
+          of[4 + 4 * j] = mds.anchorX()[md[j]];
+          of[5 + 4 * j] = mds.anchorY()[md[j]];
+          of[6 + 4 * j] = mds.anchorZ()[md[j]];
+          of[7 + 4 * j] = mds.anchorRt()[md[j]];
+        }
+      }
+    }
+  };
+
+  struct OTPullDiagTC {
+    ALPAKA_FN_ACC void operator()(Acc1D const& acc,
+                                  TrackCandidatesBaseConst cands,
+                                  HitsBaseConst hits,
+                                  HitsITConst hitsIT,
+                                  unsigned int nTC,
+                                  int* out) const {
+      const unsigned int nHitsOT = hits.nHitsOT();
+      const unsigned int nHitsIT = hitsIT.metadata().size();
+      for (unsigned int r : cms::alpakatools::uniform_elements(acc, nTC)) {
+        int* o = out + kDiagTCI * r;
+        o[0] = static_cast<int>(cands.trackCandidateType()[r]);
+        o[1] = static_cast<int>(cands.pixelSeedIndex()[r]);
+        for (int slot = 0; slot < Params_TC::kLayers; ++slot)
+          for (int hs = 0; hs < Params_TC::kHitsPerLayer; ++hs)
+            o[2 + slot * Params_TC::kHitsPerLayer + hs] =
+                diagHitKey(cands.hitIndices()[r][slot][hs], hits, hitsIT, nHitsOT, nHitsIT);
+      }
+    }
+  };
+
+  struct OTPullDiagPLS {
+    ALPAKA_FN_ACC void operator()(
+        Acc1D const& acc, HitsBaseConst hits, PixelSeedsConst seeds, HitsITConst hitsIT, int* out) const {
+      const unsigned int nHitsOT = hits.nHitsOT();
+      const unsigned int nHitsIT = hitsIT.metadata().size();
+      for (unsigned int s : cms::alpakatools::uniform_elements(acc, seeds.metadata().size())) {
+        int* o = out + kDiagPLSI * s;
+        o[0] = static_cast<int>(seeds.seedIdx()[s]);
+        o[1] = static_cast<int>(seeds.nHits()[s]);
+        const unsigned int nh = seeds.nHits()[s];
+        const unsigned int nStored = nh < kMaxPLSHitsInHitsSoA ? nh : kMaxPLSHitsInHitsSoA;
+        for (unsigned int k = 0; k < kMaxPLSHitsInHitsSoA; ++k)
+          o[2 + k] = k < nStored ? diagHitKey(seeds.firstHit()[s] + k, hits, hitsIT, nHitsOT, nHitsIT) : -1;
+      }
+    }
+  };
+
+}  // namespace ALPAKA_ACCELERATOR_NAMESPACE::lst
+
+#endif
