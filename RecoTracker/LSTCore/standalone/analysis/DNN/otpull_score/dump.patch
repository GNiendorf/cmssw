+// DIAGNOSTIC PATCH ONLY: copy the OT-seeded lookup decisions and the LST objects to the host
+void LSTEvent::dumpDiag(::lst::OTPullDiagData& out) {
+  out = ::lst::OTPullDiagData();
+  auto const wd1 = cms::alpakatools::make_workdiv<Acc1D>(max_blocks, 256);
+  unsigned int const nHits = lstInputDC_->const_view().hits().metadata().size();
+  unsigned int const nHitsIT = lstInputDC_->const_view().hitsIT().metadata().size();
+  unsigned int const nHitsOT = nHits - nHitsIT;
+  unsigned int const nTripletSlots = tripletsDC_->const_view().triplets().metadata().size();
+  unsigned int const nPLS = lstInputDC_->const_view().pixelSeeds().metadata().size();
+  unsigned int const nTC = getNumberOfTrackCandidates();
+  // T3s
+  auto t3i_d = cms::alpakatools::make_device_buffer<int[]>(queue_, kDiagT3I * std::max(nTripletSlots, 1u));
+  auto t3f_d = cms::alpakatools::make_device_buffer<float[]>(queue_, kDiagT3F * std::max(nTripletSlots, 1u));
+  auto t3n_d = cms::alpakatools::make_device_buffer<unsigned int[]>(queue_, 1u);
+  alpaka::memset(queue_, t3n_d, 0);
+  alpaka::exec<Acc1D>(queue_,
+                      wd1,
+                      OTPullDiagT3{},
+                      modules_.const_view().modules(),
+                      rangesDC_->const_view(),
+                      miniDoubletsDC_->const_view().miniDoublets(),
+                      segmentsDC_->const_view().segments(),
+                      tripletsDC_->const_view().triplets(),
+                      tripletsDC_->const_view().tripletsOccupancy(),
+                      nLowerModules_,
+                      nTripletSlots,
+                      dgUsed_ ? dgUsed_->data() : nullptr,
+                      nHitsOT,
+                      dgBestCell_ ? dgBestCell_->data() : nullptr,
+                      dgBestChi2_ ? dgBestChi2_->data() : nullptr,
+                      dgCellBest_ ? dgCellBest_->data() : nullptr,
+                      dgHitBest_ ? dgHitBest_->data() : nullptr,
+                      t3i_d.data(),
+                      t3f_d.data(),
+                      t3n_d.data(),
+                      nTripletSlots);
+  auto tc_d = cms::alpakatools::make_device_buffer<int[]>(queue_, kDiagTCI * std::max(nTC, 1u));
+  if (nTC > 0)
+    alpaka::exec<Acc1D>(queue_,
+                        wd1,
+                        OTPullDiagTC{},
+                        trackCandidatesBaseDC_->const_view(),
+                        lstInputDC_->const_view().hits(),
+                        lstInputDC_->const_view().hitsIT(),
+                        nTC,
+                        tc_d.data());
+  auto pls_d = cms::alpakatools::make_device_buffer<int[]>(queue_, kDiagPLSI * std::max(nPLS, 1u));
+  if (nPLS > 0)
+    alpaka::exec<Acc1D>(queue_,
+                        wd1,
+                        OTPullDiagPLS{},
+                        lstInputDC_->const_view().hits(),
+                        lstInputDC_->const_view().pixelSeeds(),
+                        lstInputDC_->const_view().hitsIT(),
+                        pls_d.data());
+  auto t3n_h = cms::alpakatools::make_host_buffer<unsigned int[]>(queue_, 1u);
+  alpaka::memcpy(queue_, t3n_h, t3n_d);
+  auto pn_h = cms::alpakatools::make_host_buffer<unsigned int[]>(queue_, 1u);
+  pn_h.data()[0] = 0;
+  if (dgPairN_)
+    alpaka::memcpy(queue_, pn_h, *dgPairN_);
+  alpaka::wait(queue_);
+  unsigned int const nT3 = std::min(t3n_h.data()[0], nTripletSlots);
+  unsigned int const nPairsTot = pn_h.data()[0];
+  unsigned int const nPairs = std::min(nPairsTot, dgPairCap_);
+  unsigned int const nCells = otpullCells_ ? alpaka::getExtentProduct(*otpullCells_) / 6 : 0;
+  auto copyOut = [&](auto& dbuf, auto& vec, unsigned int n) {
+    using T = std::remove_reference_t<decltype(vec[0])>;
+    vec.resize(n);
+    if (n == 0)
+      return;
+    auto hb = cms::alpakatools::make_host_buffer<T[]>(queue_, n);
+    alpaka::memcpy(queue_, hb, cms::alpakatools::make_device_view(queue_, dbuf.data(), n));
+    alpaka::wait(queue_);
+    std::copy(hb.data(), hb.data() + n, vec.begin());
+  };
+  copyOut(t3i_d, out.t3i, kDiagT3I * nT3);
+  copyOut(t3f_d, out.t3f, kDiagT3F * nT3);
+  copyOut(tc_d, out.tcs, kDiagTCI * nTC);
+  copyOut(pls_d, out.pls, kDiagPLSI * nPLS);
+  if (dgPairs_)
+    copyOut(*dgPairs_, out.pairs, kOTPullDiagPairF * nPairs);
+  if (otpullCells_)
+    copyOut(*otpullCells_, out.cells, 6 * nCells);
+  if (otpullCellKeys_) {
+    std::vector<uint32_t> k;
+    copyOut(*otpullCellKeys_, k, 2 * nCells);
+    out.cellKeys.resize(k.size());
+    for (size_t i = 0; i < k.size(); ++i)
+      out.cellKeys[i] = k[i] == kOTPullEmpty ? -1 : static_cast<int>(k[i]);
+  }
+  out.info = {static_cast<int>(nHitsOT),
+              static_cast<int>(nHitsIT),
+              static_cast<int>(nPairsTot),
+              static_cast<int>(nT3),
+              static_cast<int>(nCells),
+              static_cast<int>(nTC),
+              static_cast<int>(nPLS),
+              static_cast<int>(dgPairCap_)};
+}
